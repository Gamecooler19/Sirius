# Copy to deploy/.env and fill in real values. deploy/.env is gitignored;
# only this .example file is committed. No value below is a real credential.

POSTGRES_PASSWORD=changeme
SIRIUS_DB_PASSWORD=changeme

RUSTFS_ACCESS_KEY=changeme-access-key
RUSTFS_SECRET_KEY=changeme-secret-key
RUSTFS_BUCKET=sirius-dev

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local dev over plain HTTP: the session cookie's Secure flag must be off
# locally or no browser will ever store it. Set to "true" for any real
# deployment -- the cookie is httpOnly + SameSite=Strict unconditionally
# either way; only Secure is environment-gated.
SESSION_COOKIE_SECURE=false

# Fernet key encrypting session payload fields at rest in Valkey and TOTP
# secrets at rest in Postgres. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key
TOTP_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

ENVIRONMENT=development
LOG_LEVEL=INFO

# Module 16: password-reset email links point at this origin (the
# frontend dev server's own published address). Optional -- defaults to
# http://127.0.0.1:5173 in docker-compose.yml if unset.
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Module 20: real Web Push VAPID signing keys (RFC 8292). Generate a real
# pair with:
#   docker compose run --rm api python -c "
#   from py_vapid import Vapid02
#   import base64
#   from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
#   v = Vapid02(); v.generate_keys()
#   priv = base64.urlsafe_b64encode(v.private_key.private_numbers().private_value.to_bytes(32,'big')).rstrip(b'=').decode()
#   pub = base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).rstrip(b'=').decode()
#   print('VAPID_PRIVATE_KEY='+priv); print('VAPID_PUBLIC_KEY='+pub)"
VAPID_PRIVATE_KEY=changeme-generate-a-real-vapid-private-key
VAPID_PUBLIC_KEY=changeme-generate-a-real-vapid-public-key
VAPID_SUBJECT=mailto:no-reply@sirius.app

